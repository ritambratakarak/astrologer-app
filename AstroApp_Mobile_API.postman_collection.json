              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"orderId\": \"order_XXXXXXXXXX\",\n    \"amount\": 50000,\n    \"currency\": \"INR\",\n    \"keyId\": \"rzp_test_XXXXXXXXXX\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Verify Payment & Credit Wallet (Step 2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/wallet/verify-payment", "host": ["{{api}}"], "path": ["wallet", "verify-payment"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"order_XXXXXXXXXX\",\n  \"paymentId\": \"pay_XXXXXXXXXX\",\n  \"signature\": \"razorpay_signature_string_from_sdk\",\n  \"amount\": 500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Verify the Razorpay payment and credit the wallet.\n\nCall this after the Razorpay SDK payment sheet closes successfully.\n\n**Body (all required):**\n- `orderId` — `razorpay_order_id` from SDK callback\n- `paymentId` — `razorpay_payment_id` from SDK callback\n- `signature` — `razorpay_signature` from SDK callback\n- `amount` — same amount in INR passed to Create Order"
          }
        },
