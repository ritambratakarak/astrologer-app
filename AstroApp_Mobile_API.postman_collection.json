{
  "info": {
    "name": "AstroApp Mobile API",
    "_postman_id": "astroapp-mobile-api-v2",
    "description": "Complete API collection for AstroApp Mobile Frontend.\n\n**Base URL:** `http://98.88.19.190:8000`\n\n**Auth:** All protected routes require `Authorization: Bearer {{token}}` header.\n\n**Quick Start:**\n1. Send OTP → Verify OTP → receive `accessToken` + `refreshToken`\n2. The test script auto-saves tokens to collection variables\n3. Use Refresh Token when accessToken expires",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",        "value": "http://98.88.19.190:8000", "type": "string" },
    { "key": "api",             "value": "{{base_url}}/api/v1",       "type": "string" },
    { "key": "token",           "value": "",                          "type": "string", "description": "Auto-set after Verify OTP / Admin Login" },
    { "key": "refresh_token",   "value": "",                          "type": "string", "description": "Auto-set after Verify OTP" },
    { "key": "consultation_id", "value": "",                          "type": "string" },
    { "key": "astrologer_id",   "value": "",                          "type": "string" },
    { "key": "conversation_id", "value": "",                          "type": "string" },
    { "key": "notification_id", "value": "",                          "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "description": "OTP-based phone authentication. No token required.",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/auth/send-otp", "host": ["{{api}}"], "path": ["auth", "send-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Send OTP to a phone number.\n\n**Body:**\n- `phone` (required) — valid mobile number\n\nIn development mode the OTP is printed in server logs instead of being sent via SMS."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": { "method": "POST", "url": { "raw": "{{api}}/auth/send-otp" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"OTP sent successfully\",\n  \"data\": { \"phone\": \"9876543210\" }\n}"
            }
          ]
        },
        {
          "name": "Verify OTP (Login / Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  pm.collectionVariables.set('refresh_token', json.data.refreshToken);",
                  "  console.log('Tokens saved to collection variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/auth/verify-otp", "host": ["{{api}}"], "path": ["auth", "verify-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"userType\": \"customer\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Verify OTP and login or auto-register the user.\n\n**Body:**\n- `phone` (required)\n- `otp` (required) — 6-digit code\n- `userType` (required) — `customer` | `astrologer`\n\nReturns `accessToken` and `refreshToken`. The test script auto-saves them to collection variables."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": { "method": "POST", "url": { "raw": "{{api}}/auth/verify-otp" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"refreshToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": {\n      \"_id\": \"64f1a2b3c4d5e6f7a8b9c0d1\",\n      \"fullName\": \"\",\n      \"phone\": \"9876543210\",\n      \"userType\": \"customer\",\n      \"isProfileCreated\": false,\n      \"isAccountActive\": true\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  console.log('Access token refreshed.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/auth/refresh", "host": ["{{api}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Exchange a valid `refreshToken` for a new `accessToken`.\n\nCall this when the API returns a 401 Unauthorized response."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/auth/logout", "host": ["{{api}}"], "path": ["auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Blacklist both access and refresh tokens.\n\n**Headers:** `Authorization: Bearer {{token}}`\n\n**Body:**\n- `refreshToken` (optional but recommended) — also invalidates the refresh token"
          }
        }
      ]
    },

    {
      "name": "👤 Customer",
      "description": "Customer profile management.\n\n**Requires:** Auth token with `userType: customer`",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{api}}/customer/profile", "host": ["{{api}}"], "path": ["customer", "profile"] },
            "description": "Fetch the logged-in customer's profile."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": { "method": "GET", "url": { "raw": "{{api}}/customer/profile" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Profile fetched successfully\",\n  \"data\": {\n    \"_id\": \"64f1a2b3c4d5e6f7a8b9c0d1\",\n    \"fullName\": \"John Doe\",\n    \"phone\": \"9876543210\",\n    \"email\": \"john@example.com\",\n    \"userType\": \"customer\",\n    \"isProfileCreated\": true,\n    \"isAccountActive\": true,\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/customer/profile", "host": ["{{api}}"], "path": ["customer", "profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update customer profile. All fields are optional — only send what needs to be changed."
          }
        }
      ]
    },

    {
      "name": "🔮 Astrologer",
      "description": "Browse astrologers (any auth) and manage astrologer's own profile (astrologer auth).",
      "item": [
        {
          "name": "List Astrologers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/astrologers?page=1&limit=10",
              "host": ["{{api}}"],
              "path": ["astrologers"],
              "query": [
                { "key": "page",           "value": "1",     "description": "Page number (default: 1)" },
                { "key": "limit",          "value": "10",    "description": "Items per page (default: 10)" },
                { "key": "specialization", "value": "vedic", "description": "vedic | tarot | numerology | vastu | palmistry | face_reading | prashna | muhurta | kundali | lal_kitab", "disabled": true },
                { "key": "language",       "value": "Hindi", "description": "Filter by language e.g. Hindi, English", "disabled": true },
                { "key": "minRate",        "value": "10",    "description": "Minimum chat rate (INR)", "disabled": true },
                { "key": "maxRate",        "value": "100",   "description": "Maximum chat rate (INR)", "disabled": true }
              ]
            },
            "description": "Get paginated list of approved astrologers.\n\n**Query params (all optional):**\n- `page`, `limit`\n- `specialization` — filter by expertise\n- `language` — filter by language\n- `minRate`, `maxRate` — filter by chat rate"
          }
        },
        {
          "name": "Get Astrologer Profile (by ID)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/astrologers/{{astrologer_id}}",
              "host": ["{{api}}"],
              "path": ["astrologers", "{{astrologer_id}}"]
            },
            "description": "Get a specific astrologer's public profile by their user ID.\n\nSet `{{astrologer_id}}` in collection variables."
          }
        },
        {
          "name": "Get My Profile (Astrologer)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{api}}/astrologer/profile", "host": ["{{api}}"], "path": ["astrologer", "profile"] },
            "description": "Fetch the logged-in astrologer's own full profile.\n\n**Requires:** Auth token with `userType: astrologer`"
          }
        },
        {
          "name": "Update My Profile (Astrologer)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/astrologer/profile", "host": ["{{api}}"], "path": ["astrologer", "profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Experienced vedic astrologer with 10+ years of practice.\",\n  \"experience\": 10,\n  \"chatRate\": 20,\n  \"callRate\": 30,\n  \"videoRate\": 40,\n  \"specializations\": [\"vedic\", \"tarot\"],\n  \"languages\": [\"Hindi\", \"English\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update astrologer's own profile. All fields are optional.\n\n**Validations:**\n- `bio` — max 1000 characters\n- `experience` — non-negative integer\n- `chatRate`, `callRate`, `videoRate` — non-negative numbers\n- `specializations` — array of: `vedic`, `tarot`, `numerology`, `vastu`, `palmistry`, `face_reading`, `prashna`, `muhurta`, `kundali`, `lal_kitab`\n\n**Requires:** Auth token with `userType: astrologer`"
          }
        },
        {
          "name": "Set Availability",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/astrologer/availability", "host": ["{{api}}"], "path": ["astrologer", "availability"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"chat\",\n  \"available\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Toggle online/offline availability for a specific consultation type.\n\n**Body:**\n- `type` — `chat` | `call` | `video`\n- `available` — `true` | `false`\n\n**Requires:** Auth token with `userType: astrologer`"
          }
        }
      ]
    },

    {
      "name": "📋 Astrologer Registration (KYC)",
      "description": "Astrologer onboarding/KYC flow.\n\n**Requires:** Auth token with `userType: astrologer`\n\n**Step-by-step flow:**\n1. Upload profile photo → get URL\n2. Upload PAN photo → get URL\n3. Upload Aadhar photo → get URL\n4. Upload certificates (optional) → get URLs\n5. Submit KYC with all URLs + personal/bank details\n6. Poll registration status until `approved`",
      "item": [
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{api}}/astrologer/registration/upload-document",
              "host": ["{{api}}"],
              "path": ["astrologer", "registration", "upload-document"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file",         "type": "file",  "description": "Image file (jpg / png / pdf)" },
                { "key": "documentName", "type": "text",  "value": "Profile Photo",  "description": "Human-readable label" },
                { "key": "documentType", "type": "text",  "value": "profilePhoto",   "description": "profilePhoto | panPhoto | aadharPhoto | certificate | other" }
              ]
            },
            "description": "Upload a single document. Returns the file URL to reference in Submit KYC.\n\n**Content-Type:** `multipart/form-data`\n\n**`documentType` values:**\n- `profilePhoto`\n- `panPhoto`\n- `aadharPhoto`\n- `certificate`\n- `other`"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": { "method": "POST", "url": { "raw": "{{api}}/astrologer/registration/upload-document" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Document uploaded successfully.\",\n  \"data\": {\n    \"_id\": \"doc_64f1a2b3c4d5e6f7\",\n    \"documentName\": \"Profile Photo\",\n    \"documentType\": \"profilePhoto\",\n    \"url\": \"/uploads/1700000000000-profile.jpg\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get My Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/astrologer/registration/documents",
              "host": ["{{api}}"],
              "path": ["astrologer", "registration", "documents"]
            },
            "description": "List all documents previously uploaded by this astrologer."
          }
        },
        {
          "name": "Submit KYC",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{api}}/astrologer/registration/kyc",
              "host": ["{{api}}"],
              "path": ["astrologer", "registration", "kyc"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ravi Sharma\",\n  \"degree\": \"M.A. in Jyotish Vidya\",\n  \"experience\": 8,\n  \"secondaryContact\": \"9123456789\",\n  \"profilePhotoUrl\": \"/uploads/1700000000000-profile.jpg\",\n  \"panCard\": {\n    \"number\": \"ABCDE1234F\",\n    \"photoUrl\": \"/uploads/1700000000001-pan.jpg\"\n  },\n  \"aadharCard\": {\n    \"number\": \"123456789012\",\n    \"photoUrl\": \"/uploads/1700000000002-aadhar.jpg\"\n  },\n  \"certificateUrls\": [\n    \"/uploads/1700000000003-cert.jpg\"\n  ],\n  \"address\": {\n    \"street\": \"123 Temple Road\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"400001\",\n    \"country\": \"India\"\n  },\n  \"bankDetails\": {\n    \"accountHolderName\": \"Ravi Sharma\",\n    \"accountNumber\": \"9876543210123\",\n    \"bankName\": \"State Bank of India\",\n    \"ifscCode\": \"SBIN0001234\",\n    \"upiId\": \"ravi@upi\"\n  },\n  \"specializations\": [\"vedic\", \"kundali\"],\n  \"languages\": [\"Hindi\", \"English\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Submit KYC details. Use URLs returned from the Upload Document API.\n\n**Required fields:**\n- `fullName`, `degree`, `experience` (years), `secondaryContact`\n- `profilePhotoUrl` — from upload API\n- `panCard.number` (format: `ABCDE1234F`), `panCard.photoUrl`\n- `aadharCard.number` (12 digits), `aadharCard.photoUrl`\n- `address.city`, `address.state`, `address.pincode` (6 digits)\n- `bankDetails.accountHolderName`, `accountNumber`, `bankName`\n- `bankDetails.ifscCode` (format: `ABCD0XXXXXX`)\n\n**Optional:** `certificateUrls[]`, `address.street`, `bankDetails.upiId`, `specializations[]`, `languages[]`"
          }
        },
        {
          "name": "Get Registration Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/astrologer/registration/status",
              "host": ["{{api}}"],
              "path": ["astrologer", "registration", "status"]
            },
            "description": "Check the current KYC approval status.\n\n**Possible statuses:** `pending` | `approved` | `rejected` | `suspended`\n\nIf `rejected`, the response includes `rejectionReason`."
          },
          "response": [
            {
              "name": "Pending",
              "originalRequest": { "method": "GET", "url": { "raw": "{{api}}/astrologer/registration/status" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"status\": \"pending\",\n    \"isKycSubmitted\": true,\n    \"rejectionReason\": null\n  }\n}"
            }
          ]
        }
      ]
    },

    {
      "name": "📞 Consultation",
      "description": "Book and manage consultations between customers and astrologers.\n\n**Requires:** Auth token (customer or astrologer)",
      "item": [
        {
          "name": "Create Consultation (Customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{api}}/consultations", "host": ["{{api}}"], "path": ["consultations"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"astrologerId\": \"{{astrologer_id}}\",\n  \"type\": \"chat\",\n  \"customerNote\": \"I need guidance about my career path.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Book a consultation with an astrologer. Customer only.\n\n**Body:**\n- `astrologerId` (required) — target astrologer's user ID\n- `type` (required) — `chat` | `call` | `video`\n- `customerNote` (optional) — initial message/question"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": { "method": "POST", "url": { "raw": "{{api}}/consultations" } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Consultation created\",\n  \"data\": {\n    \"_id\": \"cons_64f1a2b3c4d5e6f7\",\n    \"astrologerId\": \"...\",\n    \"customerId\": \"...\",\n    \"type\": \"chat\",\n    \"status\": \"pending\",\n    \"customerNote\": \"I need guidance about my career path.\",\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "List My Consultations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/consultations?page=1&limit=10",
              "host": ["{{api}}"],
              "path": ["consultations"],
              "query": [
                { "key": "page",   "value": "1",         "description": "Page number" },
                { "key": "limit",  "value": "10",        "description": "Items per page" },
                { "key": "status", "value": "pending",   "description": "pending | active | completed | cancelled", "disabled": true }
              ]
            },
            "description": "List consultations for the logged-in user.\n\nAutomatically returns customer's or astrologer's consultations based on the token's `userType`."
          }
        },
        {
          "name": "Get Consultation by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/consultations/{{consultation_id}}",
              "host": ["{{api}}"],
              "path": ["consultations", "{{consultation_id}}"]
            },
            "description": "Get full details of a single consultation by ID."
          }
        },
        {
          "name": "Respond to Consultation (Astrologer)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{api}}/consultations/{{consultation_id}}/respond",
              "host": ["{{api}}"],
              "path": ["consultations", "{{consultation_id}}", "respond"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accept\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Astrologer accepts or rejects a pending consultation request.\n\n**Body:**\n- `accept: true` → status becomes `active` (session begins)\n- `accept: false` → status becomes `cancelled`\n\n**Requires:** Auth token with `userType: astrologer`"
          }
        },
        {
          "name": "End Consultation",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{api}}/consultations/{{consultation_id}}/end",
              "host": ["{{api}}"],
              "path": ["consultations", "{{consultation_id}}", "end"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "End an active consultation and mark it as `completed`.\n\nCan be triggered by either the customer or astrologer."
          }
        }
      ]
    },

    {
      "name": "💬 Chat",
      "description": "Chat message history. Real-time messaging is via Socket.IO — these REST APIs load message history.\n\n**Requires:** Auth token",
      "item": [
        {
          "name": "Get Chat Messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/chat/{{consultation_id}}/messages?page=1&limit=50",
              "host": ["{{api}}"],
              "path": ["chat", "{{consultation_id}}", "messages"],
              "query": [
                { "key": "page",  "value": "1",  "description": "Page number (most recent first)" },
                { "key": "limit", "value": "50", "description": "Messages per page" }
              ]
            },
            "description": "Fetch paginated chat messages for a consultation.\n\nTo load older messages, increment `page`. Messages are sorted newest first."
          }
        },
        {
          "name": "Mark Messages as Read",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{api}}/chat/conversations/{{conversation_id}}/read",
              "host": ["{{api}}"],
              "path": ["chat", "conversations", "{{conversation_id}}", "read"]
            },
            "description": "Mark all messages in a conversation as read for the logged-in user. Resets unread badge count.\n\nSet `{{conversation_id}}` from the consultation object."
          }
        }
      ]
    },

    {
      "name": "💰 Wallet",
      "description": "Wallet balance and Razorpay recharge flow.\n\n**Recharge flow:**\n1. Create Payment Order → get `orderId`\n2. Pass `orderId`, `amount`, `currency`, `keyId` to Razorpay SDK\n3. On payment success, call Verify Payment with the SDK response",
      "item": [
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "url": { "raw": "{{api}}/wallet", "host": ["{{api}}"], "path": ["wallet"] },
            "description": "Get the logged-in user's current wallet balance."
          },
          "response": [
            {
              "name": "Success",
